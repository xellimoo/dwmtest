#!/bin/sh
# ~/.config/edwm/autostart.sh -- run once by edwm at startup.
#
# edwm runs this detached, so a program that blocks will not hold up the
# window manager. Everything here inherits the session environment edwm has
# already set up, so D-Bus, portals and the keyring are reachable.

# A compositor, if you want the theme's [tone] opacity to mean anything.
# Needs useargb = 1 in config.h.
# picom --daemon &

# Notification daemon. Nothing shows notifications without one.
# dunst &

# StatusNotifierItem applets (Electron, Telegram, nm-applet) need no bridge:
# edwm hosts them itself. Just start them.
# nm-applet &

# Authentication agent, so apps can ask for privileges.
# /usr/libexec/polkit-gnome-authentication-agent-1 &

# Secrets, for anything that stores passwords.
# gnome-keyring-daemon --start --components=secrets,ssh &

# Something to feed the status bar. edwm reads the root window name.
# while :; do xsetroot -name "$(date '+%a %d %b  %H:%M')"; sleep 30; done &
