# A light theme, to prove the system is not dark-only
[palette]
bg      = #FAFAFA
fg      = #37474F
bright  = #FFFFFF
accent  = #1976D2
border  = #CFD8DC
urgent  = #D32F2F
muted   = #90A4AE

[scheme]
sel      = bright, accent, accent
tagsel   = bright, accent, accent
tasksel  = bright, accent, accent
status   = muted, bg, border
