# edwm theme configuration -- ~/.config/edwm/theme.conf
#
# Edit and save this file: edwm reloads it immediately. No recompile, no
# restart, nothing lost.
#
#   edwmctl theme nord              switch preset
#   edwmctl theme list              what presets exist
#   edwmctl tone hue=+20            retint everything, live
#   edwmctl reload                  force a re-read
#
# The file is read top to bottom and later keys win, so "theme = <name>"
# belongs at the top: it is the base, and anything below customises it.
# edwmctl writes that line for you.

# theme = nord

# The palette. Everything else refers to these by name, which is what makes
# recolouring the whole window manager a one-line change.
#
# Left commented so that "theme = <name>" above actually takes effect --
# uncommenting a colour here deliberately overrides the preset for that one
# entry, which is exactly how you tweak a theme you almost like. The values
# shown are edwm's built-in defaults.
#[palette]
#bg      = #222222
#fg      = #bbbbbb
#bright  = #eeeeee
#accent  = #005577
#border  = #444444
#urgent  = #cc3333
#muted   = #666666

# Applied to every palette colour before use. Sweep these to shift the whole
# scheme at once rather than editing each colour.
[tone]
hue        = 0      # degrees to rotate, -360..360
saturation = 1.0    # multiplier
lightness  = 1.0    # multiplier
contrast   = 1.0    # push away from mid grey
opacity    = 1.0    # bar background alpha; needs useargb = 1 and a compositor

# How each part of the bar is coloured, as: fg, bg, border. The names refer to
# [palette] above, but a literal such as #ff8800 works too. Uncomment to
# override; anything left out follows the palette.
#[scheme]
#norm     = fg,     bg,     border
#sel      = bright, accent, accent
#tagnorm  = fg,     bg,     border
#tagsel   = bright, accent, accent
#tasknorm = fg,     bg,     border     # taskbar button
#tasksel  = bright, accent, accent     # ... focused
#taskurg  = bright, urgent, urgent     # ... demanding attention
#taskmin  = muted,  bg,     border     # ... minimised
#status   = fg,     bg,     border
#systray  = fg,     bg,     border
#menu     = fg,     bg,     border     # tray applet menus
#menusel  = bright, accent, accent     # ... highlighted row
#menudim  = muted,  bg,     border     # ... disabled rows and separators

# Changing the size here resizes the bar and re-lays out every window.
#[font]
#main     = JetBrains Mono:size=10
#fallback = Symbols Nerd Font:size=10

[metrics]
border.width     = 2
#bar.padding     = 0
#task.maxwidth   = 220    # widest a taskbar button gets
#task.minwidth   = 60     # narrowest before buttons share the space equally
#systray.iconsize = 16
#systray.spacing  = 2
