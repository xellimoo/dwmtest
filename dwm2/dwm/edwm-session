#!/bin/sh
# edwm-session -- start edwm as a proper desktop session.
#
# The window manager itself sets up as much as it can, but a few things have to
# happen around it rather than inside it. Use this as the session command (see
# edwm.desktop) or from ~/.xinitrc:
#
#     exec edwm-session
#
# What it guarantees:
#   * exactly one session bus, and one that the rest of the session shares
#   * DISPLAY/XAUTHORITY and the desktop identity visible to D-Bus activation
#     and to systemd --user, so portals and the keyring work
#   * a systemd --user target that ordinary user services can hook onto

set -eu

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-edwm}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-edwm}"
export DESKTOP_SESSION="${DESKTOP_SESSION:-edwm}"

# Where a session bus socket would already be. $XDG_RUNTIME_DIR is the portable
# spelling; /run/user/$UID is where systemd puts it, and is checked as a
# fallback for logind sessions that did not export the variable. On systems
# with neither -- FreeBSD without a session manager -- no socket is found and
# we start our own below.
bus_socket() {
	if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
		echo "$XDG_RUNTIME_DIR/bus"
	elif [ -S "/run/user/$(id -u)/bus" ]; then
		echo "/run/user/$(id -u)/bus"
	fi
}

# With no session bus at all, start one wrapping the whole session so every
# process in it shares the same bus. Never do this when a bus already exists:
# a second bus is the classic cause of "my file picker hangs".
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -z "$(bus_socket)" ]; then
	exec dbus-run-session -- "$0" "$@"
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
	DBUS_SESSION_BUS_ADDRESS="unix:path=$(bus_socket)"
	export DBUS_SESSION_BUS_ADDRESS
fi

# Make the session visible to anything D-Bus or systemd activates later.
# --systemd is only meaningful where systemd is running, so it is asked for
# only there; on the BSDs the plain form does the D-Bus half, which is the
# part that matters.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
	if [ -d /run/systemd/system ]; then
		set -- --systemd
	else
		set --
	fi
	dbus-update-activation-environment "$@" \
		DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
		XDG_SESSION_DESKTOP DESKTOP_SESSION >/dev/null 2>&1 || true
elif command -v systemctl >/dev/null 2>&1; then
	systemctl --user import-environment \
		DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
		XDG_SESSION_DESKTOP DESKTOP_SESSION >/dev/null 2>&1 || true
fi

# Let user services that want a graphical session start.
if command -v systemctl >/dev/null 2>&1; then
	systemctl --user start graphical-session.target >/dev/null 2>&1 || true
fi

stop_target() {
	if command -v systemctl >/dev/null 2>&1; then
		systemctl --user stop graphical-session.target >/dev/null 2>&1 || true
	fi
}
trap stop_target EXIT

exec dwm "$@"
