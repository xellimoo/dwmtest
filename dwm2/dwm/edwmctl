#!/bin/sh
# edwmctl -- control a running edwm.
#
# Talks over D-Bus when the WM was built with it, and otherwise falls back to
# writing the _EDWM_CMD property on the root window. Both paths reach the same
# command vocabulary, so theming works in a build without libdbus.

set -eu

BUS_DEST=org.edwm.WM
BUS_PATH=/org/edwm/WM
BUS_IFACE=org.edwm.WM

usage() {
	cat >&2 <<'USAGE'
usage: edwmctl <command> [args]

  theme <name>          switch to themes/<name>.theme and remember it
  theme list            list available themes
  theme get             print the current theme name
  reload                re-read the theme file
  tone <k=v> [k=v ...]  adjust hue, saturation, lightness, contrast, opacity
  quit                  ask the window manager to exit

examples:
  edwmctl theme nord
  edwmctl tone hue=+20 saturation=1.2 opacity=0.9
  edwmctl tone hue=0 saturation=1 lightness=1 contrast=1 opacity=1   # reset
USAGE
	exit 2
}

have_dbus() {
	command -v gdbus >/dev/null 2>&1 || return 1
	gdbus introspect --session --dest "$BUS_DEST" --object-path "$BUS_PATH" \
		>/dev/null 2>&1
}

# Fallback transport: a string property on the root window. propertynotify in
# the WM picks it up and clears it.
send_prop() {
	command -v xprop >/dev/null 2>&1 || {
		echo "edwmctl: neither the edwm D-Bus service nor xprop is available" >&2
		exit 1
	}
	xprop -root -f _EDWM_CMD 8u -set _EDWM_CMD "$1"
}

send() {
	if have_dbus; then
		gdbus call --session --dest "$BUS_DEST" --object-path "$BUS_PATH" \
			--method "$BUS_IFACE.Command" "$1" >/dev/null
	else
		send_prop "$1"
	fi
}

themedirs() {
	echo "${XDG_CONFIG_HOME:-$HOME/.config}/edwm/themes"
	echo "/usr/local/share/edwm/themes"
}

[ $# -ge 1 ] || usage

case "$1" in
theme)
	[ $# -ge 2 ] || usage
	case "$2" in
	list)
		themedirs | while read -r d; do
			[ -d "$d" ] || continue
			for f in "$d"/*.theme; do
				[ -e "$f" ] || continue
				b=${f##*/}
				echo "${b%.theme}"
			done
		done | sort -u
		;;
	get)
		sed -n 's/^[[:space:]]*theme[[:space:]]*=[[:space:]]*\([^#;]*\).*/\1/p' \
			"${XDG_CONFIG_HOME:-$HOME/.config}/edwm/theme.conf" 2>/dev/null \
			| tail -1 | tr -d '[:space:]' || true
		echo
		;;
	*)
		send "theme $2"
		;;
	esac
	;;
reload)
	send reload
	;;
tone)
	shift
	[ $# -ge 1 ] || usage
	send "tone $*"
	;;
quit)
	send quit
	;;
*)
	usage
	;;
esac
